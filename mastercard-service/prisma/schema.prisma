generator client {
  provider                    = "prisma-client-py"
  interface                   = "sync"
  enable_experimental_decimal = true
  output                      = "../.venv/Lib/site-packages/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardTransactionStatus {
  approved
  rejected
}

model Card {
  id       Int     @id @default(autoincrement())
  pan      String  @unique @db.VarChar(16)
  cvv      String  @db.VarChar(4)
  expiry   String  @db.VarChar(5)
  holder   String  @db.VarChar(100)
  balance  Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true)

  @@map("cards")
}

model CardTransaction {
  id              Int                   @id @default(autoincrement())
  lastFourDigits  String                @db.VarChar(4)
  amount          Decimal               @db.Decimal(10, 2)
  status          CardTransactionStatus
  rejectionReason String?               @db.VarChar(255)
  reference       String?               @db.VarChar(100)
  cardHolder      String?               @db.VarChar(100)
  createdAt       DateTime              @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("card_transactions")
}
